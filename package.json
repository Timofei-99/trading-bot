{
  "name": "trading-bot",
  "version": "0.1.0",
  "description": "ICT / Smart Money Concepts strategy-construction toolkit: composable pattern detectors, multi-timeframe strategies and a bar-by-bar backtest engine.",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "build": "tsc -b",
    "build:clean": "tsc -b --clean",
    "start": "npm run build && node apps/api/dist/main.js",
    "start:dev": "ts-node -r tsconfig-paths/register apps/api/src/main.ts",
    "cli": "ts-node -r tsconfig-paths/register apps/cli/src/cli.ts",
    "cli:prod": "npm run build && node apps/cli/dist/cli.js",
    "seed-cache": "ts-node -r tsconfig-paths/register scripts/seed-cache.ts",
    "download-dax": "ts-node -r tsconfig-paths/register scripts/download-dax-dukascopy.ts",
    "download-ger40": "ts-node -r tsconfig-paths/register scripts/download-ger40-oanda.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:unit": "jest --testPathPatterns '(packages|apps|scripts)/'",
    "test:parity": "jest --testPathPatterns 'test/parity/'",
    "test:e2e": "jest --testPathPatterns 'test/api/'",
    "typecheck": "tsc -b && tsc --noEmit -p tsconfig.check.json",
    "lint": "eslint packages apps test scripts --no-error-on-unmatched-pattern",
    "format": "prettier --write \"{packages,apps,test,scripts}/**/*.ts\"",
    "format:check": "prettier --check \"{packages,apps,test,scripts}/**/*.ts\"",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "dukascopy-node": "^1.50.0",
    "js-yaml": "^4.3.0",
    "luxon": "^3.7.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.28",
    "@swc/core": "^1.15.0",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/luxon": "^3.7.1",
    "@types/lzma-native": "^4.0.4",
    "@types/node": "^22.19.0",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.4.2",
    "lzma-native": "^8.0.6",
    "nest-commander-testing": "^3.5.1",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  },
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "ts-node": {
    "require": [
      "tsconfig-paths/register"
    ],
    "project": "tsconfig.check.json"
  }
}
